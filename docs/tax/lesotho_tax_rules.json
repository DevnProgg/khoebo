      "rate_25": 0.25,
      "rate_40": 0.40,
      "applies_to": "S128-I Part H line 3d: property income of under-18 residents and other non-residents, plus s109 election cases",
      "does_not_apply_to": "ordinary resident sole trader business income",
      "source_ids": ["S20-S128-I-2023", "S1-ITA-1993"]
    }
