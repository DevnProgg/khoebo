  "provisional_tax": {
    "who_pays": ["companies", "individuals_carrying_on_business"],
    "instalments": [
      {
        "number": 1,
        "due_month": 9,
        "due_day": 30,
        "rate_of_prior_liability": 0.30
      },
      {
        "number": 2,
        "due_month": 12,
        "due_day": 31,
        "rate_of_prior_liability": 0.30
      },
      {
        "number": 3,
        "due_month": 3,
        "due_day": 31,
        "rate_of_prior_liability": 0.30
      }
    ],
    "formula": "each_instalment = 0.30 * (A - B)",
    "definitions": {
      "A": "prior_year_tax_liability_after_foreign_tax_credit_before_ACT_setoff",
      "B": "amount_of_A_paid_by_withholding_at_source_in_prior_year"
